{
  "manifest_version": 3,
  "name": "YouTube Next Upload (Prototype)",
  "version": "0.0.1",
  "description": "Extracts current YouTube video metadata needed to find the next upload.",
  "permissions": ["storage"],
  "host_permissions": ["*://youtube.com/*", "*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://youtube.com/*", "*://*.youtube.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "YouTube Next Upload"
  }
}
